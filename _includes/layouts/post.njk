---
layout: layouts/base.njk
---

{% block content %}

<section id="sidebar">
  <div id="about" class="sidebar-content">
    <h2 class="section-title">About</h2>
    <p>
      Lorem ipsum dolor sit amet consectetur adipiscing elit. Consectetur
      adipiscing elit quisque faucibus ex sapien vitae.
    </p>
  </div>
  <div class="sidebar-content">
    <h2 class="section-title">Categories</h2>
    <ul>
      <li class="sb-important"><a href="/">All</a></li>
      <li>Readings</li>
      <li>Projects</li>
      
      <li>Etc</li>
    </ul>
  </div>
  <div class="sidebar-content">
    <h2 class="section-title">More</h2>
    <ul>
      <a href="/portfolio/"><li class="sb-important">My Portfolio</li></a>
      <a href="https://github.com"><li>Github</li></a>
    </ul>
  </div>
  <p><a href="/">← Back to all posts</a></p>
</section>

<section id="blog">
  <article class="post-full">
  <h2>{{ title }}</h2>
    {% if image %}
    <img src="{{ image }}" alt="{{ title }}" class="post-img post-img--full" />
    {% endif %}

    
    <div class="post-info">
      <h4>{{ category or "post" }} |</h4>
	  <h4>&nbsp;{{ post.date | readableDate }}</h4>
    </div>

    <div class="post-body">
      {{ content | safe }}
    </div>


  </article>
</section>

{% endblock %}
